import numpy as np
import networkx as nx
import pandas as pd
from pathlib import Path
from itertools import combinations

folder_P = Path(
    "/Users/stevehalley/Code/Github/QuantumHypergraphPartitioning/data/email-Enron/numpy_15"
)

hard_instances = {"email-Enron_1", "email-Enron_4", "email-Enron_9"}

results = []

for file in sorted(folder_P.glob("*.npy")):

    H = np.load(file)

    n_vertices, n_hyperedges = H.shape

    # Each COLUMN is a hyperedge
    hyperedges = [
        list(np.flatnonzero(H[:, j]))
        for j in range(n_hyperedges)
    ]

    # Create clique expansion
    G = nx.Graph()
    G.add_nodes_from(range(n_vertices))

    for edge in hyperedges:
        G.add_edges_from(combinations(edge, 2))

    components = list(nx.connected_components(G))
    degrees = [d for _, d in G.degree()]
    edge_sizes = [len(edge) for edge in hyperedges]

    # Spectral gap
    if n_vertices > 1:
        L = nx.laplacian_matrix(G).toarray()
        eigenvalues = np.linalg.eigvalsh(L)
        spectral_gap = max(0.0, eigenvalues[1])
    else:
        spectral_gap = 0.0

    results.append({
        "instance": file.stem,
        "hard": file.stem in hard_instances,
        "vertices": n_vertices,
        "hyperedges": n_hyperedges,
        "graph_edges": G.number_of_edges(),
        "density": nx.density(G),
        "avg_degree": np.mean(degrees),
        "min_degree": min(degrees),
        "components": len(components),
        "largest_component": max(len(c) for c in components),
        "avg_hyperedge_size": np.mean(edge_sizes),
        "max_hyperedge_size": max(edge_sizes),
        "clustering": nx.average_clustering(G),
        "spectral_gap": spectral_gap,
    })

df = pd.DataFrame(results)

df["instance_num"] = (
    df["instance"].str.extract(r"_(\d+)$").astype(int)
)

df = df.sort_values("instance_num")

print(df.round(4).to_string(index=False))



