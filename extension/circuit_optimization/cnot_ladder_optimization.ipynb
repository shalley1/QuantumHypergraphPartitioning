   ],
   "source": [
    "import pennylane as qml\n",
    "\n",
    "op = qml.PauliRot(0.5, \"ZZZZ\", wires=[0, 1, 2, 3])\n",
    "\n",
    "# Decompose to elementary CNOT and RZ gates\n",
    "ops = qml.transforms.decompose(\n",
    "    qml.tape.QuantumScript([op]),\n",
    "    gate_set={qml.CNOT, qml.RZ}\n",
    ")[0][0]\n",
    "\n",
    "print(qml.drawer.tape_text(ops))\n",
    "\n",
    "print(qml.specs) "
   ]
  },
