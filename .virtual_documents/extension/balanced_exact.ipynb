import itertools

def generate_conflicting_hypergraph(n, k):
    """
    Construct a k-uniform hypergraph that cannot
    have all its hyperedges cut.
    """
    vertices = range(2 * k - 1)

    edges = list(itertools.combinations(vertices, k))
    weights = np.ones(len(edges))

    return edges, weights


n = 16

for k in [3, 4]:
    edges, weights = generate_conflicting_hypergraph(n, k)

    x_opt, cut_opt, optimal_cost = optimal_max_bisection(
        n, edges, weights
    )

    print(
        f"k={k}",
        f"edges={len(edges)}",
        f"optimal={optimal_cost}",
        f"fraction={optimal_cost / len(edges):.3f}"
    )


