import numpy as np
import matplotlib.pyplot as plt
from itertools import combinations
from scipy.optimize import linprog

n = 6
edges = list(combinations(range(n), 3))
weights = [1] * len(edges)

balanced_fair_cut(edges, weights, n)

# Generate every balanced bitstring
bitstrings = []

for ones in combinations(range(n), n // 2):
    x = np.zeros(n, dtype=int)
    x[list(ones)] = 1
    bitstrings.append(x)

bitstrings = np.array(bitstrings)
labels = ["".join(map(str, x)) for x in bitstrings]

# AoN: 1 if the hyperedge contains both 0 and 1
A = np.array([
    [int(len(set(x[v] for v in edge)) > 1)
     for x in bitstrings]
    for edge in edges
])

# Maximize minimum hyperedge cut probability
m = len(bitstrings)

c = np.zeros(m + 1)
c[-1] = -1

A_ub = np.column_stack([-A, np.ones(len(edges))])
b_ub = np.zeros(len(edges))

A_eq = np.array([[*np.ones(m), 0]])
b_eq = [1]

result = linprog(
    c,
    A_ub=A_ub,
    b_ub=b_ub,
    A_eq=A_eq,
    b_eq=b_eq,
    bounds=[(0, 1)] * m + [(0, 1)],
    method="highs"
)

if not result.success:
    raise RuntimeError(result.message)

probabilities = result.x[:-1]
cut_probabilities = A @ probabilities
t = result.x[-1]

# Plot results
fig, axes = plt.subplots(1, 2, figsize=(15, 4.5))

axes[0].bar(labels, probabilities)
axes[0].set_title("Distribution Over Balanced Bitstrings")
axes[0].set_xlabel("Bitstring")
axes[0].set_ylabel("Probability")
axes[0].tick_params(axis="x", rotation=90)

edge_labels = [str(e) for e in edges]
axes[1].bar(edge_labels, cut_probabilities)
axes[1].axhline(t, color="red", linestyle="--",
                label=f"t = {t:.3f}")
axes[1].set_title("Hyperedge Cut Probabilities")
axes[1].set_ylabel("Probability")
axes[1].set_ylim(0, 1.05)
axes[1].legend()

plt.tight_layout()
plt.show()

print(f"Optimal fair-cut value: {t:.6f}")

print("\nNonzero bitstring probabilities:")
for label, p in zip(labels, probabilities):
    if p > 1e-8:
        print(f"{label}: {p:.4f}")

print("\nHyperedge cut probabilities:")
for edge, p in zip(edges, cut_probabilities):
    print(f"{edge}: {p:.4f}")




